Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "numero": 10,
    "capacidad": 4,
    "estado_id": 1
}

###

GET {{base_url}}/mesas/1/comandas
Accept: application/json
Authorization: Bearer {{token}}

###

GET {{base_url}}/comandas
Accept: application/json
Authorization: Bearer {{token}}

###

GET {{base_url}}/comandas/1/detalles
Accept: application/json
Authorization: Bearer {{token}}

###

