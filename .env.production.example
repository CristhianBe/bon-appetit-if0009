# Lab 14 — Variables de PRODUCCIÓN (plantilla, sin valores reales).
# Los valores reales viven SOLO en las variables de entorno de Railway, nunca en el repo.
# Si falta alguna obligatoria, el contenedor no arranca (ver docker/entrypoint.sh).

APP_NAME="Bon Appétit"
APP_ENV=production
APP_DEBUG=false
APP_KEY=            # obligatoria — generar con: php artisan key:generate --show
APP_URL=            # obligatoria — ej. https://<dominio>.up.railway.app

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql # obligatoria
DB_HOST=            # obligatoria — referencia a ${{MySQL.MYSQLHOST}}
DB_PORT=            # obligatoria — referencia a ${{MySQL.MYSQLPORT}}
DB_DATABASE=        # obligatoria — referencia a ${{MySQL.MYSQLDATABASE}}
DB_USERNAME=        # obligatoria — referencia a ${{MySQL.MYSQLUSER}}
DB_PASSWORD=        # obligatoria — referencia a ${{MySQL.MYSQLPASSWORD}}

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Solo en el primer despliegue para cargar catálogos/usuarios; luego eliminarla.
SEED_ON_BOOT=false
