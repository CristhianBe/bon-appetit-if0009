# URL base de la API Laravel.
# - Emulador de Android:          http://10.0.2.2:8000/api   (10.0.2.2 = localhost de tu PC)
# - Dispositivo físico (misma red): http://<IP-LAN-de-tu-PC>:8000/api
# - Navegador (npm run dev):       http://localhost:8000/api
# El backend debe correr con: php artisan serve --host=0.0.0.0 --port=8000
VITE_API_URL=http://10.0.2.2:8000/api
